# Sanity (mevcut)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Opsiyonel: Dataset "Require API token" açıksa veya ağ hatası alıyorsanız token ekleyin (Sanity Manage > API > Tokens)
# SANITY_API_READ_TOKEN=

# Site adı – Meta başlıklar, footer, PDF ve e-postalarda kullanılır. Hardcoded marka yok.
# NEXT_PUBLIC_SITE_NAME=Çeşme Poseidon

# Müşteri rezervasyon takvimi: bu tarihten önceki günler seçilemez (YYYY-MM-DD). Varsayılan: 2026-05-28
# NEXT_PUBLIC_BOOKING_SALES_OPEN_DATE=2026-05-28

# Site URL – Sitede ve e-postadaki (Rezervasyonumu Yönet vb.) linkler bu adresi kullanır.
# Vercel’de otomatik gelir; kendi sunucunuzda tanımlayın (örn. https://cesmetekneturu.net).
# NEXT_PUBLIC_SITE_URL=https://cesmetekneturu.net

# Canonical domain: www vs non-www. Middleware 301 ile diğerini buna yönlendirir.
# Varsayılan: non-www (www gelenler non-www'ye gider). www canonical istersen true yap.
# NEXT_PUBLIC_CANONICAL_PREFER_WWW=false

# Google Analytics (GA4): NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID (yukarıdaki Firebase Web app) varsa
# otomatik kullanılır. Ayrı property kullanacaksanız NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXX ekleyin.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin (rezervasyonlar Firestore'a sadece server-side yazılır)
# Service account JSON'dan alın: project_id, client_email, private_key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Supabase (rezervasyonlar vb.) — NEXT_PUBLIC_* tarayıcıya açılır; asla service role koymayın.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... (yalnızca istemci / yerelde sunucu yedek anahtarı için)
# Sunucu (API routes, Server Components): üretimde zorunlu — RLS’yi bypass eder; gizli tutun.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin oturumu: JWT imzası (en az 24 karakter). Middleware ve /api/admin/session/* için zorunlu.
# ADMIN_JWT_SECRET=

# Opsiyonel: Bu değer .env’de tanımlıysa /login ekranında “panel güvenlik anahtarı” alanı çıkar;
# giriş isteğinde aynı değer gönderilmeden oturum açılmaz (e-posta/şifre bilinse bile).
# ADMIN_LOGIN_TOKEN=

# Eski / uyumluluk: bazı API’lerde Bearer (tercihen admin_users + JWT oturumu kullanın)
ADMIN_TOKEN=
# Opsiyonel: Sadece bu e-postalar admin paneline giriş yapabilsin (virgülle ayırın)
# ALLOWED_ADMIN_EMAILS=admin@alanadi.com,baska@alanadi.com

# POST /api/ticket/pdf: üretimde zorunlu (Authorization: Bearer …). Geliştirmede boş bırakılırsa Bearer istenmez.
# TICKET_PDF_SECRET=

# Biletçi / Acente: Sadece manuel rezervasyon ekleyebilir. https://siteniz.com/biletci
# E-posta + şifre girişi (önerilen): POST /api/admin/agent/login — JWT Bearer + X-Admin-Email
AGENT_LOGIN_EMAIL=biletci@alanadi.com
# Biletçi oturum JWT imzası (en az 24 karakter); ADMIN_JWT_SECRET’ten farklı tutun
# AGENT_JWT_SECRET=
# Şifre: üretimde bcrypt hash tercih edin ($2… ile başlar). Geliştirme için düz metin:
# AGENT_PASSWORD_HASH=$2a$10$...
# AGENT_LOGIN_PASSWORD=gecici-sifre
#
# Eski / uyumluluk: statik Bearer (Authorization: Bearer AGENT_TOKEN + X-Admin-Email)
AGENT_TOKEN=
# Opsiyonel: JWT veya AGENT_TOKEN ile gelen e-posta bu listede olmalı (virgülle). Boş = tümü.
# ALLOWED_AGENT_EMAILS=biletci@alanadi.com

# Resend - rezervasyon e-postaları (müşteri + admin)
RESEND_API_KEY=
# Admin bildirimleri — Vercel'de ayrı satır veya virgülle:
# ADMIN_EMAIL=hantalhusnu@gmail.com, turkeycesme@gmail.com
# ADMIN_EMAIL_2= (opsiyonel ek adres)
ADMIN_EMAIL=
# İsteğe bağlı: gönderici adresi (örn. Poseidon Booking <booking@yourdomain.com>)
# EMAIL_FROM=
# Rezervasyon onay e-postasındaki iletişim bilgileri
# SUPPORT_PHONE=+90 555 123 4567
# SUPPORT_EMAIL=destek@cesmeposeidon.com
# Ödeme sonrası başarı ekranında tıklanabilir tel/e-posta (isteğe bağlı; sunucu SUPPORT_* ile aynı değerleri verebilirsiniz)
# NEXT_PUBLIC_SUPPORT_PHONE=+90 555 123 4567
# NEXT_PUBLIC_SUPPORT_EMAIL=destek@cesmeposeidon.com

# Online ödeme (sanal POS). Yalnızca tam olarak "true" iken kart/ödeme adımı çalışır; boş veya false = kapalı uyarısı.
# NEXT_PUBLIC_BOOKING_PAYMENT_ENABLED=true
# Hash/ödeme sorunlarını teşhis ederken geçici olarak "1" yapın — giden isteğin hash
# alan listesi + plaintext uzunluğu + hash değeri ve banka yanıtı hash doğrulama
# detayları loglanır (storeKey asla tam loglanmaz, sadece ilk+son 3 karakter).
# NODE_ENV=production dışında zaten varsayılan olarak açıktır; sadece canlıda
# geçici teşhis için gerekir. Test bitince kaldırın.
# PAYMENT_DEBUG=1
# Payten / NestPay (3D Pay Hosting) — değerler banka / Payten panelinden; örnek isimler:
# NESTPAY_CLIENT_ID=
# NESTPAY_STORE_KEY=
# NESTPAY_GATEWAY_URL=https://...  (dökümandaki tam kök; yol /fim/Paytengate vb. gerekirse bankadan alın)
# 3D kart + şifre ekranı: storetype neredeyse daima aşağıdaki gibi (küçük harf, alt çizgi)
# NESTPAY_STORETYPE=3d_pay_hosting
# Opsiyonel: form alanı firmaadi (imzaya girer) — yoksa NEXT_PUBLIC_SITE_NAME denenir
# NESTPAY_FIRMA_ADI=
# Payten ödeme sayfası: okUrl / failUrl’e otomatik yönlendirme öncesi bekleme (saniye, 1–600). Boş = 10.
# NESTPAY_REFRESHTIME=10
# Callback HASH doğrulamasında ek dışlama (virgülle, bü/küçük harf yok): örn. payResults.dsId,weirdKey
# NESTPAY_CALLBACK_EXTRA_EXCLUDE=
# Yabancı (çoğunlukla ABD menşeli) kartların büyük kısmı 3D Secure'a kayıtlı değildir — bu alan
# false/boş iken mdStatus 2/3/4 (Half 3D: kart 3D'ye kayıtlı değil) dönen TÜM işlemler reddedilir,
# en sık "yabancı kartta ödeme geçmiyor" şikayetinin kök nedeni budur. true yapmak bu kartları da
# kabul eder — KARŞILIĞINDA: işlem artık tam 3D doğrulanmadığı için dolandırıcılık/chargeback
# sorumluluğu bankadan üye işyerine geçebilir (kart şebekesi liability-shift kuralı). İş
# Bankası/Payten ile konuşup bilinçli karar verin; biz varsayılan olarak false (daha güvenli) bırakıyoruz.
# NESTPAY_ACCEPT_HALF_3D=false
# Dinamik Kur Dönüşümü (DCC): NestPay dokümanlarında işyerinin göndereceği ayrı bir parametre YOK —
# DCC tamamen bankanın kendi 3D Secure (ACS) sayfasında, kart sahibine otomatik sunuluyor; bunu
# koddan açıp kapatamayız. DCC aktifse bankanın yanıta eklediği ekstra alanlar (querydcchash,
# showdcchash) zaten hash doğrulamasından hariç tutuluyor (bkz. lib/nestpay/hash.ts) — yani DCC'li
# yabancı kart işlemleri hash hatası yüzünden reddedilmez. DCC'nin üye işyeri hesabınızda aktif
# olup olmadığını İş Bankası/Payten'den teyit edin.
# İptal (Void) ve İade (Credit) API kullanıcısı — Payten/İşbankası API panelinden
# NESTPAY_API_USER=
# NESTPAY_API_PASSWORD=
# API için ClientId — genellikle NESTPAY_API_USER'ın "api" suffix'i çıkarılmış hali
# (örn. "700703152165api" → "700703152165"). Farklıysa buraya yaz.
# NESTPAY_API_CLIENT_ID=
# Opsiyonel: otomatik algılanır (NESTPAY_GATEWAY_URL'ye göre test/prod); farklıysa burada belirtin
# NESTPAY_API_URL=https://entegrasyon.asseco-see.com.tr/fim/api

# Fixie: Sunucudan dış HTTPS (banka whitelist sabit IP) — yalnızca bu URL kullanılır; NESTPAY_HTTPS_PROXY yok (lib/proxyClient.ts).
# Fixie panelindeki Proxy URL’yi yapıştırın (http://... ile başlar).
# FIXIE_URL=
# Opsiyonel: Canlıda /api/debug/proxy-ip’yi tarayıcıdan test için uzun rastgele string (örn. openssl rand -hex 32).
# Örnek: https://siten.com/api/debug/proxy-ip?secret=BURAYA_AYNI_DEGER
# FIXIE_IP_DEBUG_SECRET=

# Rate limit (lib/rateLimit.ts): admin girişi, iletişim, rezervasyon API’leri vb.
#
# Çoklu instance / horizontal scale: bellek içi limit her makinede ayrıdır; tutarlı limit için Upstash Redis ekleyin:
# Upstash Console → Redis → oluştur → “REST API” bölümündeki URL ve token’ı buraya yapıştırın.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
#
# IP: Vercel ve benzeri platformlar genelde güvenilir X-Forwarded-For üretir. Kendi sunucunuzda uygulamayı
# doğrudan dışarı açmayın; nginx/caddy arkasında çalıştırın ve yalnızca güvenilir proxy’nin IP başlıklarını yazmasına izin verin
# (aksi halde istemci sahte X-Forwarded-For ile limiti dağıtabilir). Cloudflare önünde CF-Connecting-IP otomatik kullanılır.

# İngilizce/Almanca sayfa çevirisi (lib/i18n/runtimeTranslate.ts): Sanity'e hiçbir şey yazılmaz, sayfa
# her istekte anlık çevrilir (30 gün önbellekli). DEEPL_API_KEY tanımlıysa yüksek kaliteli DeepL kullanılır;
# tanımlı değilse ücretsiz/anahtarsız MyMemory'ye düşer (düşük/orta kalite, günlük kotalı — yoğun kullanımda
# "kota bitti" uyarısı verip o istek için orijinal Türkçe metni gösterir, siteyi bozmaz).
# DeepL ücretsiz hesap: deepl.com/pro-api → "DeepL API Free" planı → anahtar ":fx" ile biter (500.000 karakter/ay).
# DEEPL_API_KEY=

# Cloudflare Turnstile (Contact form – site key public, secret server-only)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── WhatsApp bildirimleri (Meta WhatsApp Cloud API) — kurulum: docs/WHATSAPP_KURULUM.md ──
# Anahtarlar boşsa sistem hiç mesaj göndermez (yalnızca loglar).
# WHATSAPP_ACCESS_TOKEN=          # Meta System User kalıcı erişim anahtarı (whatsapp_business_messaging izni)
# WHATSAPP_PHONE_NUMBER_ID=       # WhatsApp Manager → Telefon numarası → "Phone number ID"
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_LANGUAGES=tr,en   # Meta'da onaylattığınız şablon dilleri (tr,en,de,ru)
# WHATSAPP_TEMPLATE_CONFIRMATION=poseidon_rezervasyon_onayi
# WHATSAPP_TEMPLATE_REMINDER_24H=poseidon_hatirlatma_24s
# WHATSAPP_TEMPLATE_REMINDER_2H=poseidon_hatirlatma_2s
# WHATSAPP_TEMPLATE_DISRUPTION=poseidon_sefer_duyurusu
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=  # webhook doğrulama için kendi belirlediğiniz rastgele metin
# WHATSAPP_APP_SECRET=            # Meta App → Settings → Basic → App secret (webhook imzası)
# WHATSAPP_DISABLED=1             # geçici olarak tüm gönderimi kapatmak için
# CRON_SECRET=                    # hatırlatma görevi (/api/cron/whatsapp-reminders) için zorunlu


# ── SEO: anında yenileme + IndexNow — kurulum: docs/SEO_KURULUM.md ──
# SANITY_REVALIDATE_SECRET=       # Sanity webhook "Secret" alanıyla aynı rastgele metin (/api/revalidate)
# INDEXNOW_KEY=                   # 8–128 karakter harf/rakam; /indexnow.txt adresinde yayınlanır (Bing/Yandex bildirimi)
