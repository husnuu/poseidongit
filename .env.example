# Sanity (mevcut)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Opsiyonel: Dataset "Require API token" açıksa veya ağ hatası alıyorsanız token ekleyin (Sanity Manage > API > Tokens)
# SANITY_API_READ_TOKEN=

# Site adı – Meta başlıklar, footer, PDF ve e-postalarda kullanılır. Hardcoded marka yok.
# NEXT_PUBLIC_SITE_NAME=Çeşme Poseidon

# Site URL – Sitede ve e-postadaki (Rezervasyonumu Yönet vb.) linkler bu adresi kullanır.
# Vercel’de otomatik gelir; kendi sunucunuzda tanımlayın (örn. https://cesmetekneturu.net).
# NEXT_PUBLIC_SITE_URL=https://cesmetekneturu.net

# Canonical domain: www vs non-www. Middleware 301 ile diğerini buna yönlendirir.
# Varsayılan: non-www (www gelenler non-www'ye gider). www canonical istersen true yap.
# NEXT_PUBLIC_CANONICAL_PREFER_WWW=false

# Google Analytics (GA4): NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID (yukarıdaki Firebase Web app) varsa
# otomatik kullanılır. Ayrı property kullanacaksanız NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXX ekleyin.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin (rezervasyonlar Firestore'a sadece server-side yazılır)
# Service account JSON'dan alın: project_id, client_email, private_key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin panel: girişte şifre (güçlü bir rastgele string kullanın)
ADMIN_TOKEN=
# Opsiyonel: Sadece bu e-postalar admin paneline giriş yapabilsin (virgülle ayırın)
# ALLOWED_ADMIN_EMAILS=admin@alanadi.com,baska@alanadi.com

# Biletçi / Acente: Sadece manuel rezervasyon ekleyebilir. /admin/biletci
AGENT_TOKEN=
# Opsiyonel: Sadece bu e-postalar biletçi paneline giriş yapabilsin (virgülle ayırın)
# ALLOWED_AGENT_EMAILS=biletci@alanadi.com

# Resend - rezervasyon e-postaları (müşteri + admin)
RESEND_API_KEY=
ADMIN_EMAIL=
# İsteğe bağlı: gönderici adresi (örn. Poseidon Booking <booking@yourdomain.com>)
# EMAIL_FROM=
# Rezervasyon onay e-postasındaki iletişim bilgileri
# SUPPORT_PHONE=+90 555 123 4567
# SUPPORT_EMAIL=destek@cesmeposeidon.com
# Ödeme sonrası başarı ekranında tıklanabilir tel/e-posta (isteğe bağlı; sunucu SUPPORT_* ile aynı değerleri verebilirsiniz)
# NEXT_PUBLIC_SUPPORT_PHONE=+90 555 123 4567
# NEXT_PUBLIC_SUPPORT_EMAIL=destek@cesmeposeidon.com

# Cloudflare Turnstile (Contact form – site key public, secret server-only)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
