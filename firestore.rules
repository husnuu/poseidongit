rules_version = '2';
// Özet: İstemci (tarayıcı / mobil SDK) hiçbir hassas koleksiyona doğrudan yazamaz.
// Okuma da kapalıdır; tüm iş mantığı Next.js API + Firebase Admin SDK üzerinden gider (kuralları bypass eder).
//
// KVKK / GDPR: Kişisel veri içeren koleksiyonlar için "allow read: if true" KULLANMAYIN.

service cloud.firestore {
  match /databases/{database}/documents {

    // Rezervasyonlar — yalnızca sunucu (Admin SDK). İstemciden okuma/yazma yok.
    match /bookings/{bookingId} {
      allow read, write: if false;
    }

    // Yat / motoryat talep formları — oluşturma ve listeleme API üzerinden (Admin SDK).
    match /yachtInquiries/{inquiryId} {
      allow read, write: if false;
    }

    // Yönetici hesabı: Firebase Auth ile giriş yapmış kullanıcı yalnızca kendi profilini okuyabilir (isAdmin vb.).
    // Yazma yine sunucuda veya Console’dan; istemci users dokümanını değiştiremez.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Diğer tüm yollar kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
