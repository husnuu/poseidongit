{
  "name": "poseidonbooking",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "rm -rf .next node_modules/.cache && NEXT_DISABLE_DEVTOOLS=1 next dev -p 3002",
    "dev:turbo": "next dev -p 3002 --turbo",
    "dev:lan": "next dev -p 3002 -H 0.0.0.0",
    "dev:3000": "next dev -p 3000",
    "dev:4000": "next dev -p 4000",
    "dev:5000": "next dev -p 5000",
    "dev:safe": "rm -rf .next && next dev -p 3002",
    "dev:clean": "rm -rf .next node_modules/.cache && next dev -p 3002",
    "dev:studio": "sanity dev --port 3333",
    "build": "next build",
    "build:clean": "rm -rf .next node_modules/.cache && next build",
    "build:safe": "rm -rf .next node_modules/.cache && NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start",
    "lint": "next lint",
    "studio": "sanity dev --port 3333",
    "studio:3335": "sanity dev --port 3335",
    "studio:fix": "sh -c 'for p in $(lsof -ti :3333 2>/dev/null); do kill -9 \"$p\" 2>/dev/null; done; exec sanity dev --port 3333'",
    "studio:build": "sanity build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@marsidev/react-turnstile": "^1.4.2",
    "@opentelemetry/api": "^1.9.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@portabletext/react": "^4.0.0",
    "@sanity/client": "^6.22.0",
    "@sanity/image-url": "^1.0.2",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "https-proxy-agent": "^8.0.0",
    "jose": "^6.2.1",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.575.0",
    "next": "^15.0.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.71.2",
    "react-phone-number-input": "^3.4.16",
    "resend": "^6.9.3",
    "sanity": "^3.99.0",
    "styled-components": "^6.3.11",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  }
}
